# PRESET: server 1 vCPU / 1 GB RAM (+ swap 2 GB, lihat server/server-setup.sh)
# Untuk server besar: cp env.large.example .env
COMPOSE_PROJECT_NAME=nvf

# --- Image (pin versi agar hasil bisa direproduksi; ideal: pin digest) ---
MYSQL_IMAGE=mysql:8.0
PHP_FPM_IMAGE=php:8.3-fpm
FRANKEN_IMAGE=dunglas/frankenphp:1-php8.3
NGINX_IMAGE=nginx:1.28

# --- Anggaran CPU: total aplikasi = 1.0 vCPU di kedua stack ---
# Nginx+FPM: 0.2 + 0.8 = 1.0   |   FrankenPHP: 1.0
# (cpus = batas maksimum, bukan reservasi; DB tetap berebut 1 core yang sama)
WEB_CPUS=0.2
FPM_CPUS=0.8
FRANKEN_CPUS=1
DB_CPUS=1

# --- Anggaran memori (total ~690 MB, sisanya untuk OS + Docker) ---
WEB_MEM=48m
APP_MEM=256m
DB_MEM=384m

# --- MySQL dikecilkan agar muat di 1 GB ---
DB_BUFFER_POOL=96M
DB_MAX_CONN=200

# --- Kapasitas PHP: samakan jumlah worker di semua varian ---
FPM_MAX_CHILDREN=8
PHP_THREADS=8
# FrankenPHP worker mode: num_threads harus > jumlah worker
PHP_THREADS_TOTAL=9
