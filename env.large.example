# Preset untuk server besar (>= 8 core / 8 GB). Salin menjadi .env bila perlu:
#   cp env.large.example .env
COMPOSE_PROJECT_NAME=nvf

MYSQL_IMAGE=mysql:8.0
PHP_FPM_IMAGE=php:8.3-fpm
FRANKEN_IMAGE=dunglas/frankenphp:1-php8.3
NGINX_IMAGE=nginx:1.28

# Stack Nginx+FPM (0.5 + 1.5) = FrankenPHP (2.0)
WEB_CPUS=0.5
FPM_CPUS=1.5
FRANKEN_CPUS=2
WEB_MEM=256m
APP_MEM=1g
DB_CPUS=2
DB_MEM=1g
DB_BUFFER_POOL=256M
DB_MAX_CONN=1000

FPM_MAX_CHILDREN=16
PHP_THREADS=16
PHP_THREADS_TOTAL=17
